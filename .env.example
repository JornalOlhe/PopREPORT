# PopReport — configuração local
# Copie este arquivo para .env. O .env real é ignorado pelo Git e não deve ser publicado.

# Servidor
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=popreport
DB_CONNECTION_LIMIT=8

# Spotify Web API
# Crie um app em developer.spotify.com e preencha as duas credenciais apenas no .env local.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=BR
SPOTIFY_REQUEST_TIMEOUT_MS=8000
